---
import { sitePath } from '../data/urls';
import Media from './Media.astro';
import type { Project } from '../data/portfolio';
const { project: p } = Astro.props as { project: Project };
const links = [{label:'Play build',url:p.play},{label:'Source code',url:p.source},{label:'Watch trailer',url:p.trailer},{label:'Documentation',url:p.documentation}].filter(link => link.url);
const showcase = p.showcase || [];
const paragraphs = (p.challengesTakeaways || '').split(/\n\s*\n/).filter(text => text.trim());
---
<article class="wrap breakdown project-detail">
  <a class="text-link back-link" href={sitePath('/#projects')}>← All projects</a>
  <header class="project-detail-header">
    <span class="eyebrow accent">{p.category}{p.sample && ' · SAMPLE PROJECT'}</span>
    <h1>{p.title}<span class="accent">.</span></h1>
    <div class="tags">{[p.engine,p.language,p.type].filter(Boolean).map(tag => <span>{tag}</span>)}</div>
  </header>
  <section class="project-detail-section" aria-labelledby="about-project">
    <h2 id="about-project">About project</h2>
    {p.role && <p class="project-role"><strong>Role:</strong> {p.role}</p>}
    {p.description && <p>{p.description}</p>}
    {(p.team || p.duration) && <p class="project-small-facts">{p.team && <span>Team: {p.team}</span>}{p.duration && <span>Duration: {p.duration}</span>}</p>}
  </section>
  {p.contributions.length > 0 && <section class="project-detail-section" aria-labelledby="contributions">
    <h2 id="contributions">Technical Contributions</h2>
    <ul>{p.contributions.map(item => <li>{item}</li>)}</ul>
  </section>}
  {paragraphs.length > 0 && <section class="project-detail-section" aria-labelledby="takeaways">
    <h2 id="takeaways">Challenges & Takeaways</h2>
    {paragraphs.map(text => <p class="project-paragraph">{text}</p>)}
  </section>}
  <section class="project-detail-section project-showcase" aria-labelledby="showcase">
    <h2 id="showcase">Showcase</h2>
    {showcase.length ? showcase.map(item => <figure>
      {item.type === 'video' ? <video src={item.src} controls preload="metadata" aria-label={item.alt}>{item.captions && <track kind="captions" src={item.captions} srclang="en" label="English" default/>}Your browser does not support video.</video> : <a href={item.src} target="_blank" rel="noopener" aria-label={`Open full image: ${item.alt}`}><img src={item.src} alt={item.alt} loading="lazy"/></a>}
      {item.caption && <figcaption>{item.caption}</figcaption>}
      {item.type === 'video' && item.transcript && <p>{item.transcript}</p>}
    </figure>) : <Media theme={p.theme}/>}
  </section>
  {links.length > 0 && <div class="project-detail-links">{links.map(link => <a class="button secondary" href={link.url!}>{link.label} ↗</a>)}</div>}
  <a class="text-link" href={sitePath('/#projects')}>← Back to all projects</a>
</article>
