---
import { sitePath } from '../data/urls';
import Media from './Media.astro';
import type { Project } from '../data/portfolio';
const { project: p } = Astro.props as { project: Project };
const links = [{label:'Play build',url:p.play},{label:'Source code',url:p.source},{label:'Watch trailer',url:p.trailer},{label:'Documentation',url:p.documentation}];
---
<article class="wrap breakdown"><a class="text-link back-link" href={sitePath('/#projects')}>← All projects</a><div class="eyebrow accent">{p.number} / {p.category} {p.sample && '· SAMPLE BREAKDOWN'}</div><h1>{p.title}<span class="accent">.</span></h1><p class="breakdown-intro">{p.description}</p><div class="notice"><span class="notice-icon">i</span><p>{p.overview}</p></div><Media theme={p.theme} src={p.media} type={p.mediaType} alt={p.mediaAlt} captions={p.captions} transcript={p.transcript}/><dl class="facts">{[{label:'Role',value:p.role},{label:'Engine',value:p.engine},{label:'Language',value:p.language},{label:'Team size',value:p.team},{label:'Duration',value:p.duration}].map(f => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl><div class="breakdown-body"><aside><span class="eyebrow">IN THIS BREAKDOWN</span><a href="#built">What I Built</a><a href="#challenges">Technical Challenges</a><a href="#architecture">Under the Hood</a><a href="#learned">What I Learned</a></aside><div><section id="built"><span class="eyebrow accent">01 / CONTRIBUTIONS</span><h2>What I Built</h2><ul>{p.contributions.map(item => <li>{item}</li>)}</ul></section><section id="challenges"><span class="eyebrow accent">02 / PROBLEM SOLVING</span><h2>Technical Challenges</h2><h3>The problem</h3><p>{p.problem}</p><h3>The approach</h3><p>{p.solution}</p><h3>The outcome</h3><p>{p.outcome}</p></section><section id="architecture"><span class="eyebrow accent">03 / UNDER THE HOOD</span><h2>Make the thinking visible.</h2>{p.diagram ? <img class="diagram" src={p.diagram} alt="Project architecture diagram" loading="lazy"/> : <div class="diagram-placeholder"><span aria-hidden="true">[ INPUT ] → [ SYSTEM ] → [ OUTPUT ]</span><p>Architecture diagram / annotated screenshot</p><small>Add a diagram and an explanation of how the pieces connect.</small></div>}{p.code ? <pre><code>{p.code}</code></pre> : <div class="code-placeholder"><span>CODE EXCERPT / TO BE ADDED</span><p>Add a short, relevant snippet and explain the decision it illustrates.</p></div>}</section><section id="learned"><span class="eyebrow accent">04 / REFLECTION</span><h2>What I Learned</h2><p>{p.learned}</p></section><div class="project-resources"><h3>Explore the project</h3>{links.some(l=>l.url) ? links.filter(l=>l.url).map(l=><a class="button secondary" href={l.url!}>{l.label} ↗</a>) : <p>Playable build, repository, trailer, and documentation links have not been added yet.</p>}</div></div></div><a class="button primary" href={sitePath('/#projects')}>Back to all projects <span>↗</span></a></article>
