---
import Layout from '../layouts/Layout.astro';
import Media from '../components/Media.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGroup from '../components/SkillGroup.astro';
import { profile, projects, skills } from '../data/portfolio';
const contacts = [{label:'Email', value: profile.email ? `mailto:${profile.email}` : null}, {label:'GitHub',value:profile.github},{label:'itch.io',value:profile.itch},{label:'LinkedIn',value:profile.linkedin}];
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-kicker eyebrow"><span><i></i> GAME PROGRAMMER</span><span>PORTFOLIO / {new Date().getFullYear()}</span></div>
    <h1 id="hero-title">{profile.name}<span class="accent">.</span></h1>
    <div class="hero-content"><div class="hero-copy"><h2>{profile.headline}</h2><p>{profile.intro}</p><div class="hero-actions"><a class="button primary" href="#projects">Explore My Projects <span>↘</span></a><a class="button secondary" href={profile.resume || '#resume-status'}>View Resume <span>↗</span></a></div><p class="hero-note"><span aria-hidden="true">⌘</span> Thoughtful systems. Meaningful play.</p><div class="social-inline">{contacts.filter(c => c.value && c.label !== 'LinkedIn').map(c => <a href={c.value!}>{c.label} ↗</a>)}</div></div><Media hero src={profile.heroMedia} type={profile.heroMediaType} alt={profile.heroMediaAlt} captions={profile.heroCaptions} transcript={profile.heroTranscript}/></div>
    <div class="hero-baseline"><span>GAMEPLAY / SYSTEMS / EXPERIMENTS</span><a href="#projects">SCROLL TO EXPLORE ↓</a></div>
  </section>
  <section id="projects" class="wrap section"><div class="section-top"><div><span class="eyebrow accent">01 / SELECTED WORK</span><h2>Ideas, made playable<span class="accent">.</span></h2></div><p>From the first input to the systems underneath.<br/>A closer look at how the work comes together.</p></div>{projects.some(p => p.sample) && <div class="notice"><span class="notice-icon">i</span><p>Portfolio in progress. Projects marked as samples are ready to be replaced with real work.</p></div>}<div class="projects-grid">{projects.map(project => <ProjectCard project={project}/>)}</div></section>
  <section id="about" class="wrap section about"><div class="portrait"><span class="eyebrow">PLAYER PROFILE / SS</span>{profile.portrait ? <img src={profile.portrait} alt={profile.name} loading="lazy"/> : <><div class="portrait-art" aria-hidden="true"><span>SS<span class="accent">.</span></span><div class="portrait-bracket tl"></div><div class="portrait-bracket br"></div></div><span class="eyebrow portrait-caption">PORTRAIT PLACEHOLDER</span></>}</div><div class="about-copy"><span class="eyebrow accent">02 / ABOUT ME</span><h2>The programmer<br/>behind the projects.</h2><p class="lead">{profile.about}</p><p>{profile.approach}</p>{!profile.aboutConfirmed && <span class="draft-note">EDITABLE INTRODUCTION · PERSONAL STORY TO BE ADDED</span>}<a class="text-link" href="#contact">Let’s talk games <span>↗</span></a></div></section>
  <section id="skills" class="wrap section"><div class="section-top"><div><span class="eyebrow accent">03 / THE TOOLKIT</span><h2>Behind every good mechanic.</h2></div><p>Languages, engines, and the tools<br/>that turn a question into something playable.</p></div>{!profile.skillsConfirmed && <div class="notice"><span class="notice-icon">i</span><p>Unconfirmed examples — these entries are not claims of proficiency. Actual skills will be added with supporting work.</p></div>}<div class="skills-grid">{skills.map((group,index) => <SkillGroup group={group} index={index}/>)}</div></section>
  <section id="contact" class="wrap section contact"><span class="eyebrow accent">04 / NEXT CONVERSATION</span><div class="contact-heading"><h2>Let’s build something<br/>worth <em>playing.</em></h2><span class="contact-arrow" aria-hidden="true">↗</span></div><p>Have an opportunity, a collaboration, or an interesting game idea?<br/>I’d love to hear about it.</p><div class="contact-links">{contacts.map(c => c.value ? <a href={c.value}>{c.label}<span>↗</span></a> : <div class="contact-pending"><span>{c.label}</span><small>NOT ADDED YET</small></div>)}</div><div id="resume-status" class="resume-status">{profile.resume ? <a class="text-link" href={profile.resume}>Download Resume ↗</a> : <p><strong>Resume coming soon.</strong> A resume file has not been supplied yet.</p>}</div></section>
</Layout>
